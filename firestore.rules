rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // groceryItems — readable by anyone with the API key (admin portal is auth-gated)
    // writeable by anyone with the API key (admin portal is password-protected)
    match /groceryItems/{itemId} {
      allow read, write: if true;
    }
    // expenses — same access model as groceryItems
    match /expenses/{itemId} {
      allow read, write: if true;
    }
    // menuItems — same access model as groceryItems
    match /menuItems/{itemId} {
      allow read, write: if true;
    }
    // weddingContent — public read (wedding page), open write (admin is cookie-gated)
    match /weddingContent/{docId} {
      allow read, write: if true;
    }
  }
}
